{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brandon-rv:integration-manifest",
  "title": "Brandon RV integration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "description",
    "entrypoint",
    "events",
    "config"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "entrypoint": {
      "const": "server.cjs"
    },
    "events": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\*$|^[a-z0-9][a-z0-9._-]{0,99}$"
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "enum": [
              "text",
              "url",
              "secret",
              "boolean",
              "number",
              "select"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "options": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "adminPage": {
      "type": "string",
      "const": "admin-page.tsx",
      "description": "Optional integration-owned Staff Portal page loaded by the generic integration route only while the integration is enabled."
    },
    "providesEvents": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 200,
      "description": "Events emitted by this integration and exposed to subscribers such as Mail System.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "trigger"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
