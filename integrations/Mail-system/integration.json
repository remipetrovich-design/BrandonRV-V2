{
  "id": "mail-system",
  "name": "Mail System",
  "version": "1.2.0",
  "description": "Brandon RV communications integration. Owns its templates, revisions, routing, event triggers and administration page inside this integration module.",
  "entrypoint": "server.cjs",
  "adminPage": "admin-page.tsx",
  "events": [
    "account.password_reset_requested",
    "account.password_changed",
    "staff.invitation_created",
    "customer.account_created",
    "enquiry.received",
    "quote.issued",
    "quote.accepted",
    "quote.declined",
    "quote.changes_requested",
    "booking.requested",
    "booking.confirmed",
    "booking.rescheduled",
    "booking.cancelled",
    "job.assigned",
    "job.started",
    "job.completed",
    "job.customer_approval_requested",
    "job.customer_approved",
    "job.customer_changes_requested",
    "invoice.issued",
    "payment.received",
    "payment.refunded",
    "invoice.credit_issued"
  ],
  "config": [
    {
      "key": "apiKey",
      "label": "Mail System API key",
      "type": "secret",
      "required": true,
      "description": "Dedicated active Brandon RV External System key with the mail:send scope. Stored encrypted by the V2 Integrations Manager."
    }
  ]
}
