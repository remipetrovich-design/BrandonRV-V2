# Brandon RV V2 — deployment configuration inventory
# SECTION A: VERCEL PROJECT SETTINGS -> ENVIRONMENT VARIABLES
# Add only SECTION A to Vercel. Do NOT add SECTION B to Vercel.
# SECTION B: GITHUB REPOSITORY -> Settings -> Secrets and variables -> Actions
# Add SECTION B items to GitHub in the exact Secret/Variable location marked below.
# This file is a checklist/template only. Never commit real values or expose server secrets through NEXT_PUBLIC_.

# Required — dedicated Brandon-RV-V2 Supabase project only.
SUPABASE_URL=https://lciylmfpcefdpsouoqvm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Recommended — set to the deployed V2 origin in Vercel.
NEXT_PUBLIC_APP_URL=

# Temporary — required only while creating the first owner through /setup.
# Remove from Vercel immediately after successful owner creation.
BRANDON_RV_SETUP_SECRET=

# Required before the integrated licence storage/activation is used.
# Generate a unique cryptographically-random secret of at least 32 characters.
BRANDON_RV_LICENSE_ENCRYPTION_SECRET=

# Optional — product version sent to the existing external License Manager.
# Defaults to 1.0.0 when omitted.
BRANDON_RV_VERSION=1.0.0

# Optional external mail integration — LEAVE UNSET while mail is paused.
# Configure only after separate approval to enable mail delivery.
ORBITFS_MAIL_URL=
BRANDONSRV_MAIL_API_KEY=

# VERCEL ONLY — manual deployment control (keep false until explicitly activated).
BRANDON_RV_MANUAL_DEPLOY_ENABLED=false
# VERCEL ONLY — server-side fine-grained GitHub token with Actions: write on this repository.
# Never expose to the browser or add to GitHub as a secret; this token is used by the Vercel API route to dispatch the workflow.
GITHUB_ACTIONS_DISPATCH_TOKEN=

# -----------------------------------------------------------------------------
# SECTION B — GITHUB REPOSITORY SETTINGS (NOT VERCEL ENVIRONMENT VARIABLES)
# Repository: remipetrovich-design/BrandonRV-V2
# -----------------------------------------------------------------------------

# GITHUB ACTIONS SECRET — Settings -> Secrets and variables -> Actions -> Secrets
# Supabase personal access token used by the Supabase CLI.
SUPABASE_ACCESS_TOKEN=
# Database password for the dedicated Brandon RV V2 Supabase project only.
SUPABASE_DB_PASSWORD=
# Vercel deployment token for the Vercel account/team that owns the V2 project.
VERCEL_TOKEN=
# Vercel team/account ID that owns the V2 project.
VERCEL_ORG_ID=
# Vercel project ID linked to this BrandonRV-V2 repository (must not be the old Brandon-RV project unless it is deliberately relinked).
VERCEL_PROJECT_ID=

# GITHUB ACTIONS VARIABLE — Settings -> Secrets and variables -> Actions -> Variables
# Independent workflow activation gate. Keep false until all deployment configuration is verified.
BRANDON_RV_MANUAL_DEPLOY_ENABLED=false

# Fixed in .github/workflows/manual-deploy-migrate.yml (not a secret or editable GitHub variable):
# SUPABASE_PROJECT_ID=lciylmfpcefdpsouoqvm
# The workflow intentionally targets this V2 project only.
