# Brandon RV V2 — Vercel Supabase integration variables
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are supplied by the integration.
# Server-side database access requires a Supabase Secret API key (or legacy service-role key).
# Never expose the server-side key through a NEXT_PUBLIC_ variable or commit its value.

# Server-side privileged Supabase key; configure in Vercel Production
SUPABASE_SECRET_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=
# Manual deployment + migration control — keep false until separately authorised
BRANDON_RV_MANUAL_DEPLOY_ENABLED=false
# Server-side GitHub fine-grained token with Actions: write on remipetrovich-design/BrandonRV-V2
GITHUB_ACTIONS_DISPATCH_TOKEN=
