# Brandon RV V2 — deployment environment variables
# Configure these in Vercel Project Settings -> Environment Variables.
# The standard checks workflow requires no secrets. The manual deploy workflow is separately gated.
# Never commit real values to this file or expose server secrets through NEXT_PUBLIC_.

# Required — dedicated Brandon-RV-V2 Supabase project only.
SUPABASE_URL=https://lciylmfpcefdpsouoqvm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Recommended — set to the deployed V2 origin in Vercel.
NEXT_PUBLIC_APP_URL=

# Temporary — required only while creating the first owner through /setup.
# Remove from Vercel immediately after successful owner creation.
BRANDON_RV_SETUP_SECRET=

# Required before the integrated licence storage/activation is used.
# Generate a unique cryptographically-random secret of at least 32 characters.
BRANDON_RV_LICENSE_ENCRYPTION_SECRET=

# Optional — product version sent to the existing external License Manager.
# Defaults to 1.0.0 when omitted.
BRANDON_RV_VERSION=1.0.0

# Optional external mail integration — LEAVE UNSET while mail is paused.
# Configure only after separate approval to enable mail delivery.
ORBITFS_MAIL_URL=
BRANDONSRV_MAIL_API_KEY=

# Dormant manual production deploy + V2 migration control.
# Leave false until Vercel and GitHub deployment credentials are configured and activation is approved.
BRANDON_RV_MANUAL_DEPLOY_ENABLED=false
# Server-only fine-grained GitHub token with Actions: write for this repository.
# Never prefix with NEXT_PUBLIC_ and never commit a real value.
GITHUB_ACTIONS_DISPATCH_TOKEN=
