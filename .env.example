# Brandon RV V2 — runtime environment variables
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are supplied by the Vercel Supabase integration.
# POSTGRES_URL_NON_POOLING is also supplied by that integration for the manual migration workflow.
# Keep the Supabase integration attached to the dedicated V2 project.

# Server-side privileged Supabase key (preferred)
SUPABASE_SECRET_KEY=
# Legacy compatibility fallbacks only; use the integration-provided URL and preferred secret key above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts credentials stored by the Integrations Manager. Use a long, random secret.
INTEGRATIONS_ENCRYPTION_KEY=

# Application origin (set to the new V2 domain when it is configured)
NEXT_PUBLIC_APP_URL=

# Optional in-app GitHub Actions dispatch. If unset, the admin control can open GitHub Actions instead.
GITHUB_ACTIONS_DISPATCH_TOKEN=

# Legacy flag retained for compatibility; it is not a gate for the current deployment workflow.
BRANDON_RV_MANUAL_DEPLOY_ENABLED=false
