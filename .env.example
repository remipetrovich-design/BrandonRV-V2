# Brandon RV V2 runtime configuration.
# Copy to .env.local for local development. When hosting is configured, add runtime
# values to the Vercel project environment. Do not commit real values to GitHub.
# The current GitHub Actions workflow runs tests/typecheck/build and requires no secrets.

# Required server-only database connection for all application data.
# This must always point to the dedicated V2 project, never V1.
SUPABASE_URL=https://lciylmfpcefdpsouoqvm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional canonical app origin for verification, password reset and invitation links.
# Leave blank locally to use the request origin. Set separately for each hosted environment.
NEXT_PUBLIC_APP_URL=

# Required only for the one-time first-owner bootstrap at /setup.
# Use a strong random secret, then remove it from the hosted environment after owner creation.
BRANDON_RV_SETUP_SECRET=

# Optional external OrbitFS Mail integration. Delivery remains paused until explicitly enabled.
# When enabled, use the existing BrandonRV send-only external-system key; never use a Resend key.
ORBITFS_MAIL_URL=
BRANDONSRV_MAIL_API_KEY=

# Required before activating the installed application licence.
# Generate a unique random secret of at least 32 characters. Server-only; never prefix NEXT_PUBLIC_.
BRANDON_RV_LICENSE_ENCRYPTION_SECRET=

# Optional product version sent to the external License Manager; defaults to 1.0.0.
BRANDON_RV_VERSION=1.0.0
