# Brandon RV V2 — Vercel environment variable template
# This file contains ONLY Vercel runtime variables and uses standard dotenv KEY=VALUE syntax.
# Import this file in Vercel Project Settings -> Environment Variables.
# Blank values are placeholders: fill them in Vercel after import. Do not commit real secrets.

# Supabase — dedicated Brandon RV V2 project only
SUPABASE_URL=https://lciylmfpcefdpsouoqvm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Application URL — set to the production Vercel domain
NEXT_PUBLIC_APP_URL=

# First owner setup — temporary; remove after the owner account is created
BRANDON_RV_SETUP_SECRET=

# Licence key encryption — generate a unique random secret of at least 32 characters

# Product version sent to the existing external License Manager

# External mail integration — leave blank while mail remains paused
ORBITFS_MAIL_URL=
BRANDONSRV_MAIL_API_KEY=

# Manual deployment + migration control — keep false until separately authorised
BRANDON_RV_MANUAL_DEPLOY_ENABLED=false
# Server-side GitHub fine-grained token with Actions: write on remipetrovich-design/BrandonRV-V2
GITHUB_ACTIONS_DISPATCH_TOKEN=
